# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=DataEngineeringPipeline

# Storage Configuration
# Use 'local' for filesystem or 'hdfs' for Hadoop HDFS
STORAGE_BACKEND=local
INPUT_DIR=data/sample
OUTPUT_DIR=data/output
QUARANTINE_DIR=data/quarantine

# HDFS Configuration (only used when STORAGE_BACKEND=hdfs)
HDFS_NAMENODE=localhost
HDFS_PORT=9000
HDFS_USER=hdfs

# Data Quality Settings
ENABLE_VALIDATION=true
MAX_NULL_THRESHOLD=0.5
DUPLICATE_CHECK=true

# Logging
LOG_LEVEL=INFO
