# Streaming Configuration
STREAMING_MODE=local  # Options: local, kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions
INPUT_DIR=data/input
CHECKPOINT_DIR=data/checkpoint

# Database Configuration
DB_TYPE=sqlite  # Options: sqlite, postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streaming_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
SQLITE_PATH=data/analytics.db

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=StreamingAnalytics

# Anomaly Detection
ANOMALY_THRESHOLD_MULTIPLIER=3.0
WINDOW_SIZE_SECONDS=60

# Dashboard Configuration
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO
